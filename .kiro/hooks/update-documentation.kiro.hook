{
  "version": "1.0.0",
  "enabled": true,
  "name": "Update Documentation",
  "description": "Delegates steering and README maintenance to the documentation-syncer subagent.",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Invoke the `documentation-syncer` subagent to sync steering and the README with the current code, following its steering-structure and README-audience rules."
  }
}

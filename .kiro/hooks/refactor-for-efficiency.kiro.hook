{
  "version": "1.0.0",
  "enabled": true,
  "name": "Refactor for efficiency",
  "description": "Delegates agent-efficiency refactoring analysis to the refactor-writer subagent.",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Invoke the `refactor-writer` subagent in analysis-only mode: propose a prioritized set of refactorings that make future agent sessions faster and cheaper. Do not change any code yet."
  }
}

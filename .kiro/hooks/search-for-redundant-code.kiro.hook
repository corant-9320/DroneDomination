{
  "version": "1.0.0",
  "enabled": true,
  "name": "Search for redundant code",
  "description": "Delegates the redundant/unused/duplicate code sweep to the refactor-writer subagent.",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Invoke the `refactor-writer` subagent to run a redundant-code sweep: find redundant, unused, or duplicated code (functions, classes, files, imports, commented-out blocks) and follow its rules for safe removal, verification, and reporting uncertain candidates instead of deleting them."
  }
}

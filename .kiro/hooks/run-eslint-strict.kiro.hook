{
  "enabled": true,
  "name": "Run ESLint (Strict Rules)",
  "description": "Manually runs ESLint across src, shared, and server. Enforces no-explicit-any, no-unsafe-*, no-floating-promises, switch-exhaustiveness-check, complexity, and max-lines-per-function (configured in eslint.config.js).",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": "npm run lint"
  }
}
{
  "version": "1.0.0",
  "enabled": true,
  "name": "Unit Test Maintenance",
  "description": "Delegates unit-test review and gap remediation to the unit-test-writer subagent.",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Invoke the `unit-test-writer` subagent to review and extend unit-test coverage for recently changed code, using its coverage workflow to locate gaps and its critical-review rules to flag weak or brittle existing tests."
  }
}

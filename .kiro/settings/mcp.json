{
  "mcpServers": {
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "disabled": false,
      "autoApprove": [
        "create_entities",
        "create_relations",
        "search_nodes",
        "add_observations",
        "open_nodes"
      ]
    },
    "git": {
      "command": "npx",
      "args": [
        "-y",
        "@cyanheads/git-mcp-server"
      ],
      "env": {
        "GIT_MCP_BASE_DIR": "c:\\Kiro\\DroneDomination"
      },
      "disabled": false,
      "autoApprove": [
        "git_status",
        "git_log",
        "git_diff",
        "git_branch_list",
        "git_set_working_dir",
        "git_add"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1"
      },
      "disabled": false,
      "autoApprove": [
        "navigate_page",
        "take_screenshot",
        "list_console_messages",
        "get_console_message",
        "list_network_requests",
        "get_network_request",
        "evaluate_script",
        "list_pages",
        "select_page",
        "new_page",
        "take_snapshot",
        "click",
        "wait_for",
        "resize_page"
      ]
    }
  }
}
{
  "mcpServers": {
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "C:\\Kiro\\DroneDomination\\.kiro\\memory\\graph.jsonl"
      },
      "disabled": false,
      "autoApprove": [
        "*"
      ]
    },
    "git": {
      "command": "npx",
      "args": [
        "-y",
        "@cyanheads/git-mcp-server"
      ],
      "env": {
        "GIT_MCP_BASE_DIR": "c:\\Kiro\\DroneDomination"
      },
      "disabled": false,
      "autoApprove": [
        "*"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1"
      },
      "disabled": false,
      "autoApprove": [
        "*"
      ]
    }
  }
}
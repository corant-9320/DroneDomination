{
  "mcpServers": {
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "disabled": true,
      "autoApprove": []
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1"
      },
      "disabled": true,
      "autoApprove": [
        "navigate_page",
        "take_screenshot",
        "list_console_messages",
        "get_console_message",
        "list_network_requests",
        "get_network_request",
        "evaluate_script",
        "list_pages",
        "select_page",
        "new_page"
      ]
    }
  }
}
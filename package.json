{
  "name": "drone-domination",
  "version": "0.1.0",
  "description": "Civilization-type game on a Goldberg G(24,0) sphere",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "postbuild": "node dist/src/generateCli.js",
    "generate": "node dist/src/generateCli.js",
    "validate": "node dist/src/validate.js",
    "dev": "vite",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest --coverage",
    "e2e": "node --max-old-space-size=4096 node_modules/@playwright/test/cli.js test",
    "debug:snapshot": "node scripts/debug-snapshot.mjs",
    "lint": "eslint \"src/**/*.ts\" \"shared/**/*.ts\" \"server/**/*.ts\""
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.8.0",
    "@types/three": "^0.168.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "fast-check": "4.8.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "three": "^0.168.0"
  }
}
